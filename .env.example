# --- Infrastructure ---
PORT=3000
DATABASE_URL=postgresql://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379

# x-api-key header for the admin endpoints (sources, destinations, events)
ADMIN_API_KEY=dev-admin-key

# --- Worker ---
# true: the API process also runs the delivery worker (handy for local development).
# In Docker Compose the API runs with false and a separate worker process with true.
WORKER_ENABLED=true
WORKER_CONCURRENCY=10

# --- Delivery / retry ---
DELIVERY_MAX_ATTEMPTS=5
# Wait after each failed attempt (ms): 1s, 5s, 30s, 5min
DELIVERY_RETRY_DELAYS_MS=1000,5000,30000,300000
# ±10% randomness on each delay (avoids a thundering herd)
DELIVERY_RETRY_JITTER=0.1
DELIVERY_TIMEOUT_MS=10000

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=259200
IDEMPOTENCY_LOCK_TTL_SECONDS=30

# --- Recovery (re-enqueues deliveries that never reached the queue) ---
RECOVERY_INTERVAL_MS=30000
RECOVERY_GRACE_MS=60000

# --- Misc ---
MAX_BODY_BYTES=1048576
STRIPE_TOLERANCE_SECONDS=300
LOG_LEVEL=log
LOG_JSON=false
